{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5001
    },
    {
      "name": "backend-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5002",
        "DATABASE_URL=postgresql://postgres:dev@localhost:5432/anilounge",
        "NODE_ENV=development",
        "RESEND_API_KEY=",
        "ACCOUNT_CLEANUP_ENABLED=false",
        "CATALOG_MAINTENANCE_ENABLED=false",
        "CONNECTIONS_REDIRECT_URL=http://localhost:5173/connections",
        "npm",
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5002
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:5002",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5175"
      ],
      "port": 5175
    }
  ]
}
