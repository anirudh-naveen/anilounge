{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5001
    },
    {
      "name": "backend-localdb",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://postgres:dev@localhost:5432/anilounge",
        "CONNECTIONS_SYNC_ENABLED=false",
        "KOFI_VERIFICATION_TOKEN=local-test-token",
        "NODE_ENV=development",
        "npm",
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5001
    },
    {
      "name": "frontend-donate",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_DONATE_URL=https://ko-fi.com/anilounge",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5175"
      ],
      "port": 5175
    },
    {
      "name": "backend-prodcopy",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://postgres:dev@localhost:5433/anilounge",
        "CONTENT_SYNC_ENABLED=false",
        "CONNECTIONS_SYNC_ENABLED=false",
        "RELEASE_THREADS_ENABLED=false",
        "NODE_ENV=development",
        "npm",
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5001
    },
    {
      "name": "frontend-app",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:5002",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5176",
        "--host"
      ],
      "port": 5176
    },
    {
      "name": "backend-prodcopy-5002",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=5002",
        "DATABASE_URL=postgresql://postgres:dev@localhost:5433/anilounge",
        "CONTENT_SYNC_ENABLED=false",
        "CONNECTIONS_SYNC_ENABLED=false",
        "RELEASE_THREADS_ENABLED=false",
        "NODE_ENV=development",
        "npm",
        "--prefix",
        "backend",
        "run",
        "start"
      ],
      "port": 5002
    }
  ]
}
