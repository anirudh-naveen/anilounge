# Local Docker: docker compose up -d
DATABASE_URL=postgresql://postgres:dev@localhost:5432/anilounge

# Production AniLounge service uses the private Railway Postgres URL:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
JWT_SECRET=change-me

# Catalog and search: TMDB (https://www.themoviedb.org/settings/api) and MyAnimeList
# (https://myanimelist.net/apiconfig). Gemini powers AI chat (optional).
TMDB_API_KEY=
MAL_CLIENT_ID=
GEMINI_API_KEY=
# Deployed frontend origin(s) allowed by CORS; localhost ports are always allowed.
FRONTEND_URL=
# Comma-separated verified account emails that are always admins ("owners"); the admin
# page can't demote or ban them. Unset means only users given the admin role are admins.
# The creator (who adds/removes admins and bans users) is set once with
# `npm run role:creator -- you@example.com`, not here.
ADMIN_EMAILS=

# Outbound email (verification, lockout, inactivity, announcements), sent as
# notify@anilounge.net. Set RESEND_API_KEY (recommended; works on every Railway plan) or
# the SMTP_* values (Railway only allows SMTP on Pro). With neither, emails are printed
# to the server console. Test with: npm run email:test -- you@example.com
RESEND_API_KEY=
EMAIL_REPLY_TO=support@anilounge.net
# Inbox for beta feedback / bug reports (replies go to the submitter when they left an email).
SUPPORT_EMAIL=support@anilounge.net
# Pause between announcement emails (npm run email:announce); 600ms stays under Resend's 2/s.
ANNOUNCEMENT_DELAY_MS=600
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AniLounge <notify@anilounge.net>
# Base URL for links in emails (defaults to the first FRONTEND_URL entry). The
# announcement script refuses to --send when this is localhost or plain http.
PUBLIC_APP_URL=https://www.anilounge.net
# Footer logo; defaults to the live site's copy so it loads even from a dev machine.
# EMAIL_LOGO_URL=

# Inactive account cleanup: warns at 90/30/14/7/1 days, deletes after a year without use.
# Defaults to on in production and off elsewhere; runs daily at 09:00 UTC.
ACCOUNT_CLEANUP_ENABLED=
ACCOUNT_CLEANUP_CRON=0 9 * * *
# Same flag also removes sign-ups left unverified for 3 days (reminder 1 day before), hourly.
UNVERIFIED_CLEANUP_CRON=15 * * * *

# Connections page (/connections): users link AniList / MyAnimeList / TMDB accounts
# to import their list and keep it in sync. Watchlist edits are sent to every linked
# site; AniList and MyAnimeList changes are polled back. A site without keys shows as
# unavailable.
# AniList: create a client at https://anilist.co/settings/developer.
# MyAnimeList: create a client at https://myanimelist.net/apiconfig (MAL_CLIENT_ID is
#   shared with username imports; MAL_CLIENT_SECRET is only needed for "web" app types).
# Register CONNECTIONS_REDIRECT_URL as the redirect URL with both (default
# ${PUBLIC_APP_URL}/connections; use http://localhost:5174/connections on a dev machine).
# TMDB uses TMDB_API_KEY.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_SECRET=
CONNECTIONS_REDIRECT_URL=
# Encrypts stored access tokens; required (no site can be connected without it). Generate
# with `openssl rand -base64 48`. Every server using the same database needs the same
# value, and changing it disconnects everyone.
CONNECTIONS_SECRET=
# Polling budget. AniList allows 30-90 requests a minute per server IP, shared with
# catalog jobs; a quiet poll costs one request. Each account is polled at most once per
# interval, so with many accounts each is polled less often.
# Turn off sending and polling on this server (sign-in and imports still work). Set false
# on a dev machine whose DATABASE_URL is production, so it doesn't sync real accounts too.
CONNECTIONS_SYNC_ENABLED=true
CONNECTIONS_POLL_INTERVAL_SECONDS=120
CONNECTIONS_ANILIST_POLLS_PER_MINUTE=12
CONNECTIONS_MAL_POLLS_PER_MINUTE=20

# --- Scaling ---
# Proxy hops in front of the API (default 2, Railway's edge). GET /api/status?proxy=1 echoes
# the client IP the server sees and the forwarding headers it arrived with.
TRUST_PROXY=
# General rate limit per 15 minutes: per signed-in account, and per IP when signed out.
RATE_LIMIT_USER_MAX=1500
RATE_LIMIT_IP_MAX=600
# memory (default; one instance) or postgres (shared counters; set when running 2+ instances).
RATE_LIMIT_STORE=
# Connections per instance. Keep instances x PG_POOL_MAX under Postgres max_connections.
PG_POOL_MAX=10
# Cancel statements running longer than this (the API defaults to 60000; scripts: none).
PG_STATEMENT_TIMEOUT_MS=
# Optional read replica for public catalog/search reads (falls back to DATABASE_URL).
DATABASE_READ_URL=
# bcrypt worker threads (default: up to 2).
PASSWORD_HASH_THREADS=
# Gemini chat/search calls per day.
AI_DAILY_LIMIT_USER=200
AI_DAILY_LIMIT_ANON=30
# Site-wide chats per day (UTC), whoever asks. Also set a budget alert/cap in Google Cloud.
AI_DAILY_LIMIT_GLOBAL=3000
# Optional on-disk copy of security events (stdout always gets them).
SECURITY_LOG_DIR=
# Forum hot-score re-decay schedule; daily refresh-token cleanup schedule.
FORUM_HOT_REFRESH_CRON=*/5 * * * *
SESSION_CLEANUP_CRON=20 3 * * *

# --- Donations ---
# Ko-fi → Settings → API → Webhooks: set the URL to https://<site>/api/webhooks/kofi and
# copy its verification token here. Donations made with an account's email give it the
# Supporter badge. Unset = the webhook rejects every request.
KOFI_VERIFICATION_TOKEN=

# --- Search engines ---
# IndexNow (Bing, Yandex, Naver, Seznam, Yep): new titles and forum posts are submitted
# automatically. The key is served at /indexnow-key.txt; leave INDEXNOW_KEY blank to
# derive it from JWT_SECRET. On in production only unless INDEXNOW_ENABLED says otherwise.
INDEXNOW_KEY=
INDEXNOW_ENABLED=
