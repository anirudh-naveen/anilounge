# Local Docker: docker compose up -d
DATABASE_URL=postgresql://postgres:dev@localhost:5432/anilounge

# Production AniLounge service uses the private Railway Postgres URL:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Keep Mongo until after a rollback window.
MONGODB_URI=mongodb://localhost:27017/find-animation
JWT_SECRET=change-me

# Outbound email (verification, lockout, future announcements), sent as notify@anilounge.net.
# Leave SMTP_HOST empty locally: emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=AniLounge <notify@anilounge.net>
# Base URL for links in emails (defaults to the first FRONTEND_URL entry).
PUBLIC_APP_URL=https://anilounge.net
