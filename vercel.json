{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)backend' ':(exclude)*.md' ':(exclude).github' ':(exclude).claude' ':(exclude).vscode' ':(exclude)docker-compose.yml'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://anilounge-production.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/indexnow-key.txt",
      "destination": "https://anilounge-production.up.railway.app/api/indexnow-key.txt"
    },
    {
      "source": "/sitemaps/:path*",
      "destination": "https://anilounge-production.up.railway.app/api/sitemaps/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://anilounge-production.up.railway.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://anilounge-production.up.railway.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
